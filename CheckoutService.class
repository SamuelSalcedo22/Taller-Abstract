
import java.util.Objects;

class CheckoutService {
   private final PaymentProcessor payment;
   private final ReceiptGenerator receipt;

   CheckoutService(PaymentGatewayFactory var1) {
      Objects.requireNonNull(var1);
      this.payment = var1.createPaymentProcessor();
      this.receipt = var1.createReceiptGenerator();
   }

   public void checkout(String var1, double var2) {
      String var4 = this.payment.pay(var1, var2);
      if (var4 == null) {
         System.out.println("Pago rechazado | order=" + var1 + " | amount=" + var2);
      } else {
         System.out.println("Pago aprobado | TX=" + var4);
         System.out.println(this.receipt.receipt(var4, var2));
         System.out.println();
      }
   }
}
